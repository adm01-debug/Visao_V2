# Production Environment Variables
# NOTA: Vite injeta estas variáveis em BUILD TIME. Valor errado aqui = bundle errado.
VITE_APP_ENV=production
VITE_SUPABASE_PROJECT_ID=fsisdfdwlbfeadwfqpir
VITE_SUPABASE_URL=https://fsisdfdwlbfeadwfqpir.supabase.co

# Preenchida pelo CI a partir do secret store. A chave que estava aqui foi
# removida e DEVE SER ROTACIONADA — está no histórico do Git.
VITE_SUPABASE_PUBLISHABLE_KEY=

# MediaMTX — os 3 nomes que useMediaMTX.ts realmente lê.
# Estavam AUSENTES: o build de produção saía com localhost:8888 cravado.
VITE_MEDIAMTX_HLS_URL=https://stream.seudominio.com.br
VITE_MEDIAMTX_WEBRTC_URL=https://webrtc.seudominio.com.br
VITE_MEDIAMTX_RTSP_URL=rtsp://stream.seudominio.com.br:8554

VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true
