# ══════════════════════════════════════════════════════════════════
# VISÃO - Variáveis de Ambiente (Desenvolvimento)
# ══════════════════════════════════════════════════════════════════

VITE_APP_NAME=VISÃO
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development
VITE_APP_DEBUG=true

VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3000

# MediaMTX local (docker-compose.dev.yml)
# Nomes idênticos aos de produção — a divergência era a causa do bug.
VITE_MEDIAMTX_HLS_URL=http://localhost:8888
VITE_MEDIAMTX_WEBRTC_URL=http://localhost:8889
VITE_MEDIAMTX_RTSP_URL=rtsp://localhost:8554

VITE_ENABLE_DEVTOOLS=true
VITE_ENABLE_MOCK_DATA=true
VITE_ENABLE_HOT_RELOAD=true
VITE_ENABLE_SOURCE_MAPS=true

VITE_ENABLE_ANALYTICS=false
VITE_SENTRY_DSN=

VITE_AUTH_COOKIE_SECURE=false
VITE_SESSION_TIMEOUT=86400000

VITE_LOG_LEVEL=debug
VITE_LOG_TO_CONSOLE=true

VITE_ENABLE_PROFILER=true
VITE_SLOW_QUERY_THRESHOLD=1000
