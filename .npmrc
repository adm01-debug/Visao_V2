# ══════════════════════════════════════════════════════════════════
# VISÃO - NPM Configuration
# ══════════════════════════════════════════════════════════════════

# Registry
registry=https://registry.npmjs.org/

# Cache
cache=.npm-cache
prefer-offline=true

# Security
audit=true
fund=false

# Engine
engine-strict=true

# Save
save-exact=true
save-prefix=

# Logs
loglevel=warn

# Git
git-tag-version=true

# Install
legacy-peer-deps=false
strict-peer-deps=false

# Scripts
ignore-scripts=false
script-shell=/bin/bash
