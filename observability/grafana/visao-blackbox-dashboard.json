{
  "uid": "visao-blackbox",
  "title": "VISÃO — Blackbox Probes & SSL Expiry",
  "tags": ["visao", "blackbox", "ssl", "observability"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "target",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(probe_success{job=\"visao-blackbox-https\"}, instance)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Disponibilidade agora",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red" },
                "1": { "text": "UP", "color": "green" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "probe_success{job=\"visao-blackbox-https\", instance=~\"$target\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Dias até expiração do certificado",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "min": 0,
          "max": 90,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 3 },
              { "color": "yellow", "value": 14 },
              { "color": "green", "value": 30 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "(probe_ssl_earliest_cert_expiry{job=\"visao-blackbox-https\", instance=~\"$target\"} - time()) / 86400",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Uptime 24h (%)",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.99 },
              { "color": "green", "value": 0.999 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "avg_over_time(probe_success{job=\"visao-blackbox-https\", instance=~\"$target\"}[24h])",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latência do probe por fase (s)",
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "probe_http_duration_seconds{job=\"visao-blackbox-https\", instance=~\"$target\"}",
          "legendFormat": "{{instance}} — {{phase}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "heatmap",
      "title": "Heatmap — duração TLS handshake",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "probe_http_duration_seconds{job=\"visao-blackbox-https\", phase=\"tls\", instance=~\"$target\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Status por target",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 15 },
      "targets": [
        {
          "expr": "probe_success{job=\"visao-blackbox-https\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "(probe_ssl_earliest_cert_expiry{job=\"visao-blackbox-https\"} - time()) / 86400",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "probe_http_status_code{job=\"visao-blackbox-https\"}",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "probe_http_duration_seconds{job=\"visao-blackbox-https\", phase=\"processing\"}",
          "format": "table",
          "instant": true,
          "refId": "D"
        }
      ],
      "transformations": [
        { "id": "merge" },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "job": true, "__name__": true },
            "renameByName": {
              "instance": "Target",
              "Value #A": "Up",
              "Value #B": "Cert (dias)",
              "Value #C": "HTTP",
              "Value #D": "Processing (s)"
            }
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "HTTP status code observado",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "targets": [
        {
          "expr": "probe_http_status_code{job=\"visao-blackbox-https\", instance=~\"$target\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Falhas de probe (probe_success == 0)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "targets": [
        {
          "expr": "1 - probe_success{job=\"visao-blackbox-https\", instance=~\"$target\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    }
  ]
}
