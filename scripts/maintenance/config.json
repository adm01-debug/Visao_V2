{
  "version": 1,
  "manager": "npm",
  "tsconfigs": ["tsconfig.strict.json", "tsconfig.node.json"],
  "gates": [
    {
      "name": "lint",
      "command": ["npm", "run", "lint:ci"]
    },
    {
      "name": "types",
      "command": [
        "node",
        "scripts/maintenance/typecheck.mjs",
        "tsconfig.strict.json",
        "tsconfig.node.json"
      ]
    },
    {
      "name": "test",
      "command": ["node", "node_modules/vitest/vitest.mjs", "run", "--maxWorkers=1"]
    },
    {
      "name": "build",
      "command": ["node", "node_modules/vite/bin/vite.js", "build"]
    }
  ],
  "fix": {
    "roots": ["src"],
    "eslintRules": [],
    "prettier": true,
    "exclude": ["src/integrations/supabase/types.ts"]
  },
  "timeoutMs": 300000,
  "maxFiles": 20,
  "maxChangedLines": 400
}
