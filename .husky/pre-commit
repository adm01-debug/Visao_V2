# ─────────────────────────────────────────────────────────────
# VISÃO — pre-commit hook (Husky v9+)
#
# Estratégia em 2 camadas:
#   1. lint-staged → ESLint --max-warnings=0 nos arquivos staged (rápido)
#   2. type-check:strict + lint:ci → gates globais (paridade com ci.yml:41,44)
#
# Garante zero warnings localmente antes de chegar ao CI.
# Skip emergencial: `git commit --no-verify`
# ─────────────────────────────────────────────────────────────
set -e

echo "🔍 [pre-commit 1/3] lint-staged (eslint --max-warnings=0 nos arquivos staged)"
npx --no-install lint-staged

echo "🔍 [pre-commit 2/3] type-check:strict (paridade com ci.yml:41)"
npm run --silent type-check:strict

echo "🔍 [pre-commit 3/3] lint:ci (paridade com ci.yml:44 — continue-on-error)"
# TS 5.9.x + typescript-eslint 8.x: erros pré-existentes em 67 arquivos legados
# aguardam correção incremental (rastreado separado). Mirrors CI continue-on-error.
npm run --silent lint:ci || echo "⚠️  [pre-commit] lint:ci: erros pré-existentes (não bloqueante — ver CI)"

echo "✅ [pre-commit] todos os gates bloqueantes passaram"
