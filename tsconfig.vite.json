{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": ".",
    "strict": false,
    "tsBuildInfoFile": "./tsconfig.vite.tsbuildinfo"
  },
  "include": ["vite.config.ts"]
}