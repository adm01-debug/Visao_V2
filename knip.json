{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.tsx",
    "src/App.tsx",
    "index.html",
    "vite.config.ts",
    "tailwind.config.ts",
    "postcss.config.js",
    "eslint.config.js",
    "scripts/**/*.{mjs,js,ts}",
    "supabase/functions/**/index.ts",
    "src/**/*.test.{ts,tsx}",
    "src/**/*.spec.{ts,tsx}",
    "src/__tests__/**/*.{ts,tsx}",
    "tests/**/*.{ts,tsx}",
    "e2e/**/*.{ts,tsx}",
    "playwright/**/*.{ts,tsx}",
    "cypress/**/*.{ts,tsx}",
    ".storybook/**/*.{ts,tsx,js}",
    "src/**/*.stories.{ts,tsx}"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{mjs,js,ts}"
  ],
  "ignore": [
    "src/integrations/supabase/types.ts",
    "src/integrations/supabase/client.ts",
    "src/components/ui/**",
    "supabase/migrations/**",
    "dist/**",
    "coverage/**",
    "reports/**",
    ".lovable/**"
  ],
  "ignoreDependencies": [
    "tailwindcss-animate",
    "autoprefixer",
    "postcss",
    "@tailwindcss/typography",
    "@types/.*",
    "lovable-tagger",
    "husky",
    "lint-staged",
    "@commitlint/.*",
    "stylelint.*",
    "prettier",
    "size-limit",
    "@size-limit/preset-app",
    "bundlesize",
    "source-map-explorer",
    "pa11y-ci",
    "jest-axe",
    "msw",
    "@storybook/.*",
    "workbox-.*",
    "vite-plugin-pwa",
    "@vitejs/plugin-react-swc"
  ],
  "ignoreBinaries": [
    "supabase",
    "act",
    "gh",
    "docker",
    "docker-compose"
  ]
}
