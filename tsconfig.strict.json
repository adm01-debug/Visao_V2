{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
    // NOTE: exactOptionalPropertyTypes, noPropertyAccessFromIndexSignature e noUnusedLocals
    // estão temporariamente desligadas — backlog em docs/CODE_QUALITY_RULES.md (seção 8).
  },
  "include": ["src", "tests"],
  "exclude": [
    "node_modules", "dist", "storybook-static", "coverage",
    "**/*.stories.tsx", "**/*.stories.ts",
    "**/__tests__/**", "**/*.test.ts", "**/*.test.tsx",
    "src/test/**", "tests/e2e/**"
  ]
}
