# ============================================
# VISÃO - Sistema de Vigilância Inteligente
# ============================================
# Copie para .env e preencha. NUNCA commite .env com valores reais.

# ============================================
# SUPABASE (obrigatório)
# ============================================
VITE_SUPABASE_PROJECT_ID="seu-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-anon-key"
VITE_SUPABASE_URL="https://seu-project-id.supabase.co"

# ============================================
# MEDIAMTX — streaming
# ============================================
# Nomes alinhados 1:1 com o que src/hooks/useMediaMTX.ts consome.
# Validado pelo gate scripts/check-env-contract.mjs (CI + pre-commit).
#
# ATENÇÃO: a Control API (9997) NÃO é mais consumida pelo browser.
# O front chama a edge function `mediamtx-proxy`, que autentica no Supabase
# e só então fala com o MediaMTX pela rede interna.
VITE_MEDIAMTX_HLS_URL="https://stream.seudominio.com.br"
VITE_MEDIAMTX_WEBRTC_URL="https://webrtc.seudominio.com.br"
VITE_MEDIAMTX_RTSP_URL="rtsp://stream.seudominio.com.br:8554"

# ============================================
# SEGREDOS DE SERVIDOR
# (nunca com prefixo VITE_ — tudo que tem VITE_ vai para o bundle público!)
# ============================================
OPENAI_API_KEY="sk-..."
TELEGRAM_BOT_TOKEN="123456789:ABC..."
TELEGRAM_CHAT_ID="-100..."
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="alertas@seudominio.com"
MAPBOX_ACCESS_TOKEN="pk.eyJ1..."
BITRIX24_WEBHOOK_URL="https://seudominio.bitrix24.com.br/rest/1/webhook-token/"

# Credenciais do MediaMTX — consumidas SÓ pela edge function, nunca pelo front
MEDIAMTX_API_URL="http://mediamtx:9997"
MEDIAMTX_API_USER="visao_api"
MEDIAMTX_API_PASS="troque-me"

# ============================================
# APP
# ============================================
VITE_APP_NAME="VISÃO"
VITE_APP_VERSION="1.0.0"
VITE_API_TIMEOUT=30000
VITE_API_URL="/api"
VITE_ENABLE_ANALYTICS=false
