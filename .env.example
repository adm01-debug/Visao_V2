# ============================================
# VISÃO - Sistema de Vigilância Inteligente
# Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha com suas credenciais

# ============================================
# SUPABASE (Obrigatório)
# ============================================
VITE_SUPABASE_PROJECT_ID="seu-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-anon-key"
VITE_SUPABASE_URL="https://seu-project-id.supabase.co"

# ============================================
# OPENAI (Para análise de imagem)
# ============================================
OPENAI_API_KEY="sk-..."

# ============================================
# TELEGRAM (Para notificações)
# ============================================
TELEGRAM_BOT_TOKEN="123456789:ABC..."
TELEGRAM_CHAT_ID="-100..."

# ============================================
# RESEND (Para emails)
# ============================================
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="alertas@seudominio.com"

# ============================================
# MAPBOX (Para mapas)
# ============================================
MAPBOX_ACCESS_TOKEN="pk.eyJ1..."

# ============================================
# MEDIAMTX (Streaming Server)
# ============================================
VITE_MEDIAMTX_URL="http://localhost:8888"
VITE_MEDIAMTX_API_URL="http://localhost:9997"
VITE_MEDIAMTX_WEBRTC_URL="http://localhost:8889"

# ============================================
# BITRIX24 (Integração CRM)
# ============================================
BITRIX24_WEBHOOK_URL="https://seudominio.bitrix24.com.br/rest/1/webhook-token/"

# ============================================
# APP CONFIG
# ============================================
VITE_APP_NAME="VISÃO"
VITE_APP_VERSION="1.0.0"
VITE_API_TIMEOUT=30000
# Sentry (opcional)
VITE_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
